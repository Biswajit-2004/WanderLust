<% layout("/layouts/boilerplate") -%>

<body>
  <!-- <h3 class="mt-3 mb-3">All Listings</h3> -->
  <!-- <form method="GET" action="/listings/new">
      <button>create New listings</button>
    </form> -->

    <style>
      #filters{
        display: flex;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
      }

      .filter{
        text-align: center;
        margin-right:3rem;
        margin-top: 2rem;
        opacity: 1;
      }

      .filter:hover{
        opacity: 0.7;
        cursor: pointer;
      }

      .filter p {
        font-size: 0.8rem;
      }
      .filter{
        margin-bottom: 2rem;
        margin-right: 120px;
      }
    </style>

    <div id="filters">
      <div class="filter">
        <a href="/customer/switch-role">
          <button class="btn btn-outline-success">Become a customer</button>
        </a>
      </div>
    </div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listings of Alllistings) { %>
    <a href="/listings/<%= listings._id %>" class="listing_link">
      <div class="card col" style="width: 20rem">
        <img
          src="<%= listings.image.url %>"
          class="card-img-top"
          alt="image"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listings.title %></b> <br />
            &#8377;
            <%= listings.price ? listings.price.toLocaleString('en-IN') : 0 %>
            /night
          </p>
        </div>
      </div>
    </a>

    <% } %>
  </div>
</body>
