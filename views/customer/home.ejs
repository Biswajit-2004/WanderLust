<% layout("/layouts/customer_boilerplate") -%>

<body>
  <!-- <h3 class="mt-3 mb-3">All Listings</h3> -->
  <!-- <form method="GET" action="/listings/new">
      <button>create New listings</button>
    </form> -->

    <div id="filters">
      <a href="/customer/home?category=Trending">
      <div class="filter">
        <div class="icon"> <i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
      </div>
      </a>

      <a href="/customer/home?category=Rooms">
        <div class="filter">
        <div class="icon"> <i class="fa-solid fa-bed"></i> </div>
        <p>Rooms</p>
      </div>
      </a>

      <a href="/customer/home?category=Farms">
         <div class="filter">
        <div class="icon"> <i class="fa-solid fa-house-chimney"></i> </div>
        <p>Farms</p>
      </div>
      </a>

      <a href="/customer/home?category=Iconic cities">
         <div class="filter">
        <div class="icon"> <i class="fa-solid fa-city"></i> </div>
        <p>Iconic cities</p>
      </div>
      </a>

      <a href="/customer/home?category=Amazing pools">
         <div class="filter">
        <div class="icon"> <i class="fa-solid fa-person-swimming"></i> </div>
        <p>Amazing pools</p>
      </div>
      </a>

      <a href="/customer/home?category=Beach">
         <div class="filter">
        <div class="icon"> <i class="fa-solid fa-umbrella-beach"></i> </div>
        <p>Beach</p>
      </div>
      </a>

      <a href="/customer/home?category=Castles">
         <div class="filter">
        <div class="icon"> <i class="fa-brands fa-fort-awesome"></i> </div>
        <p>Castles</p>
      </div>
      </a>

      <a href="/customer/home?category=Arctic">
         <div class="filter">
        <div class="icon"> <i class="fa-solid fa-snowflake"></i> </div>
        <p>Arctic</p>
      </div>
      </a>

      <div class="tax-toggle">
      <div class="form-switch form-check-reverse">
  <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
  <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
</div>
</div>

        <div class="switch">
        <a href="/customer/switch-role">
            <button class="btn btn-outline-success">Become a host</button>
        </a>
        </div>

    </div>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
    <% for(let listings of Alllistings) { %>
    <a href="/customer/home/<%= listings._id %>" class="listing_link">
      <div class="card col" style="width: 20rem">
        <img
          src="<%= listings.image.url %>"
          class="card-img-top"
          alt="image"
          style="height: 20rem"
        />
        <div class="card-img-overlay"></div>
        <div class="card-body">
          <p class="card-text">
            <b><%= listings.title %></b> <br />
            &#8377;
            <%= listings.price ? listings.price.toLocaleString('en-IN') : 0 %> /night
            <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
           
          </p>
        </div>
      </div>
    </a>

    <% } %>
  </div>
</body>


<script>
  let taxSwitch = document.getElementById("switchCheckDefault");
  taxSwitch.addEventListener("click" , () => {
  let tax_info = document.getElementsByClassName("tax-info");
  for(info of tax_info){
    if(info.style.display != "inline"){
      info.style.display = "inline";
    } else{
      info.style.display = "none";
    }
  }
});
</script>