

<style>

  /* Header links (Explore, Wishlists, Trips) */
.navbar-nav.mx-auto .nav-link {
  padding: 0.35rem 0.9rem;
  border-radius: 999px;
  color: #444;
  font-weight: 500;
  transition: background-color 0.2s ease, color 0.2s ease;
}

/* Same circle for all three icons */
.icon-badge,
#wish,
#trips {
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: #f5f5f5;
  color: #444;
  transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
}

/* Icon size (overrides fs-4) */
#explore,
#wish,
#trips {
  font-size: 1rem !important;
}

/* Explore icon sits inside the badge, so no second circle */
#explore {
  background: none;
  color: inherit;
}

/* Hover */
.navbar-nav.mx-auto .nav-link:hover {
  background-color: #fff1f2;
  color: #fe424d;
}

.navbar-nav.mx-auto .nav-link:hover .icon-badge,
.navbar-nav.mx-auto .nav-link:hover #wish,
.navbar-nav.mx-auto .nav-link:hover #trips {
  background-color: #fe424d;
  color: #fff;
  transform: translateY(-2px);
}

</style>

<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    
    <a class="navbar-brand d-flex align-items-center gap-2" href="">
      <i class="fa-regular fa-compass"></i>
      <span>Wanderlust</span>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      
      <div class="navbar-nav mx-auto align-items-center gap-4">
        
          <a class="nav-link d-flex align-items-center gap-2" href="/customer/explore">
            <span class="icon-badge explore-badge">
               <i class="fa-solid fa-earth-europe fs-4" id="explore"></i>
            </span>
            <span>Explore</span>
          </a>

        <a class="nav-link d-flex align-items-center gap-2" href="/customer/wishlists">
          <i class="fa-regular fa-heart fs-4" id="wish"></i>
          <span>Wishlists</span>
        </a>

        <a class="nav-link d-flex align-items-center gap-2" href="/customer/trips">
          <i class="fa-solid fa-suitcase fs-4" id="trips"></i>
          <span>Trips</span>
        </a>

      </div>
      
      <div class="navbar-nav">
      <form  action="/customer/search" class="d-flex me-3" role="search">
        <input class="form-control me-2" type="search" name="q"  placeholder="Search destination" aria-label="Search"/>
        <button class="btn search-btn" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
          Search
        </button>
      </form>
      </div>

      <div class="navbar-nav ms-auto">
        <% if (currUser && currUser.role === "owner") { %>
          <a class="nav-link" href="/listings/new">Wanderlust your home</a>
        <% } %>

        <% if (!currUser) { %>
          <a class="nav-link" href="/customer/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/customer/login"><b>Log in</b></a>
        <% } %>

        <% if (currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
        <% } %>
      </div>

    </div>
  </div>
</nav>

